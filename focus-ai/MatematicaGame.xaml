<Window x:Class="focus_ai.MatematicaGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI - Quick Math"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        Closing="Window_Closing">
    <Grid Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack"
                        Grid.Column="0"
                        Content="← Back"
                        FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource AccentSecBg}"
                        Foreground="{DynamicResource AccentSecFg}"
                        BorderThickness="0" Cursor="Hand"
                        Padding="14,8"
                        Click="BtnBack_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentSecHov}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <TextBlock Text="05" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Quick Math" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TxtPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgStatGreen}" CornerRadius="10" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Score " FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtScore" Text="0" FontSize="16" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgStatOrange}" CornerRadius="10" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STREAK " FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStreak" Text="0" FontSize="16" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TimerBorder" Background="{DynamicResource BgStatBlue}" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TIME " FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTimer" Text="60" FontSize="16" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PanelDifficulty" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="800" Margin="52,44,52,48">
                    <TextBlock Text="COGNITIVE TRAINING  /  05" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,16" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Quick Math" FontSize="42" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Work through mental calculations with a balance of speed and accuracy. Each round lasts 60 seconds."
                               FontSize="15" Foreground="{DynamicResource TxtSecondary}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="650" Margin="0,0,0,34" LineHeight="23"/>
                    <TextBlock Text="SELECT YOUR CHALLENGE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <Grid Width="800">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="BtnEasy" Click="BtnEasy_Click" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Padding="0" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="24,21"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Foundation" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextAlignment="Left"/><TextBlock Text="Addition and subtraction · values 1–20" FontSize="13" Foreground="{DynamicResource TxtSecondary}" Margin="0,5,0,0" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="LOW LOAD" FontSize="10" FontWeight="SemiBold" Foreground="#22C55E" HorizontalAlignment="Right"/><TextBlock Text="Beginner  ↗" FontSize="12" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                        <Button Grid.Row="1" x:Name="BtnMedium" Click="BtnMedium_Click" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Padding="0" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="24,21"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Fluency" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextAlignment="Left"/><TextBlock Text="Addition, subtraction and multiplication · values 1–50" FontSize="13" Foreground="{DynamicResource TxtSecondary}" Margin="0,5,0,0" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="MODERATE LOAD" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Right"/><TextBlock Text="Intermediate  ↗" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                        <Button Grid.Row="2" x:Name="BtnHard" Click="BtnHard_Click" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Padding="0" HorizontalContentAlignment="Stretch">
                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="24,21"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="03" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Advanced reasoning" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextAlignment="Left"/><TextBlock Text="All operations including division · values 1–100" FontSize="13" Foreground="{DynamicResource TxtSecondary}" Margin="0,5,0,0" TextAlignment="Left"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="HIGH LOAD" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Right"/><TextBlock Text="Advanced  ↗" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="PanelGame" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" VerticalAlignment="Top" Height="4" Background="{DynamicResource BgSep}" Margin="0,0,0,0">
                    <Border x:Name="ProgressBar" HorizontalAlignment="Left" Height="4" Width="0"
                            Background="{DynamicResource AccentPrimary}" CornerRadius="2"/>
                </Border>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                    <TextBlock x:Name="TxtFeedback" Text="" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TxtPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0"/>
                    <Border x:Name="QuestionCard" Background="{DynamicResource BgCard}" CornerRadius="24"
                            Padding="60,48" MinWidth="420" HorizontalAlignment="Center" Margin="0,0,0,32">
                        <StackPanel>
                            <TextBlock x:Name="TxtQuestion" Text="?" FontSize="52" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtSubtitle" Text="What is the result?" FontSize="13"
                                       Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid HorizontalAlignment="Center" MinWidth="420">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="12"
                                BorderThickness="2" BorderBrush="{DynamicResource AccentPrimary}">
                            <TextBox x:Name="TxtAnswer" FontSize="22" FontWeight="SemiBold" Background="Transparent"
                                     BorderThickness="0" Foreground="{DynamicResource TxtPrimary}" Padding="18,12"
                                     VerticalContentAlignment="Center" TextAlignment="Center"
                                     KeyDown="TxtAnswer_KeyDown" PreviewTextInput="TxtAnswer_PreviewTextInput"/>
                        </Border>
                        <Button Grid.Column="2" x:Name="BtnSubmit" Content="✓" FontSize="20" FontWeight="Bold"
                                Width="54" Height="54" Background="{DynamicResource AccentPrimary}" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="BtnSubmit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="Press Enter or ✓ to confirm" FontSize="11"
                               Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource BgSidebar}" Padding="28,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource BgStatGreen}" CornerRadius="18" Padding="14,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅ Correct: " FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCorrect" Text="0" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EF444420" CornerRadius="18" Padding="14,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❌ Wrong: " FontSize="12" FontWeight="SemiBold" Foreground="#F87171" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtWrong" Text="0" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgStatPurple}" CornerRadius="18" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 Accuracy: " FontSize="12" FontWeight="SemiBold" Foreground="#C084FC" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAccuracy" Text="—" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="WinOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border CornerRadius="24" Padding="48,40" Background="{DynamicResource BgCard}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="WinEmoji" Text="SESSION COMPLETE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="WinTitle" Text="Excellent!" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TxtPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="WinSubtitle" Text=""
                               FontSize="14" Foreground="{DynamicResource TxtSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WinScore" Text="Final score: 0 / 100"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentSecFg}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="🔄  Play again"
                                Click="WinPlayAgain_Click"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White" FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18" Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="← Back to menu"
                                Click="BtnBack_Click"
                                Background="{DynamicResource AccentSecBg}"
                                Foreground="{DynamicResource AccentSecFg}"
                                FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18" Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSecHov}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>