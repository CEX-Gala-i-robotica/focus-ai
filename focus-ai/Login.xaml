<Window x:Class="focus_ai.Login" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus AI · Sign in" Height="720" Width="1080" MinHeight="650" MinWidth="980" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Color x:Key="LightWindowBg">#F4F6FB</Color><Color x:Key="LightCardBg">#FFFFFF</Color><Color x:Key="LightTextPrimary">#111827</Color><Color x:Key="LightTextSecondary">#64748B</Color><Color x:Key="LightBorder">#E2E8F0</Color><Color x:Key="LightInputBg">#F8FAFC</Color><Color x:Key="LightDivider">#E2E8F0</Color>
        <Color x:Key="DarkWindowBg">#0B0F19</Color><Color x:Key="DarkCardBg">#111827</Color><Color x:Key="DarkTextPrimary">#F5F7FC</Color><Color x:Key="DarkTextSecondary">#A6B0C2</Color><Color x:Key="DarkBorder">#273247</Color><Color x:Key="DarkInputBg">#0D1422</Color><Color x:Key="DarkDivider">#273247</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource DarkCardBg}"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/><SolidColorBrush x:Key="TextSecBrush" Color="{StaticResource DarkTextSecondary}"/><SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/><SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource DarkInputBg}"/><SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DarkDivider}"/>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="DM Sans, Segoe UI"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="DM Sans, Segoe UI"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextSecBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="AuthPrimaryButton" TargetType="Button"><Setter Property="Background" Value="#F5F7FC"/><Setter Property="Foreground" Value="#101725"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="18,13"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="AuthSecondaryButton" TargetType="Button"><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#F5F7FC"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#2C374A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16,12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5D83C7"/><Setter TargetName="Surface" Property="Background" Value="#172338"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Window.Background><SolidColorBrush x:Name="WindowBackground" Color="{StaticResource DarkWindowBg}"/></Window.Background>
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="30" ClipToBounds="True" Padding="48"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#101725" Offset="0"/><GradientStop Color="#142947" Offset="0.55"/><GradientStop Color="#1D3D75" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="44" Height="44" CornerRadius="12" Background="#EAF2FF" BorderBrush="#BBD1F5" BorderThickness="1" Margin="0,0,12,0"><Image Source="pack://application:,,,/focusai.ico" Width="29" Height="29" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Focus AI" FontSize="20" FontWeight="SemiBold" Foreground="#F7FAFF"/><TextBlock Text="CLINICAL INTELLIGENCE" FontSize="10" FontWeight="SemiBold" Foreground="#AAC0E4" Margin="0,3,0,0"/></StackPanel></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,20,10"><Border Background="#1AFFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,22"><TextBlock Text="COGNITIVE HEALTH WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#DCE8FF"/></Border><TextBlock Text="Turn every signal into understanding." FontSize="38" FontWeight="Medium" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="45"/><TextBlock Text="A focused space for patient assessments, cognitive training and meaningful progress over time." FontSize="15" Foreground="#C3D0E5" TextWrapping="Wrap" Margin="0,18,0,30" MaxWidth="470" LineHeight="24"/><StackPanel><Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="7" BorderBrush="#70A7FF" BorderThickness="1" Background="#1E3B67"><TextBlock Text="01" FontSize="9" Foreground="#EAF1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Structured assessments" FontSize="14" FontWeight="Medium" Foreground="#F7FAFF"/><TextBlock Text="Four complementary signals, one workflow." FontSize="12" Foreground="#B9C8E0" Margin="0,4,0,0"/></StackPanel></Grid><Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="7" BorderBrush="#70A7FF" BorderThickness="1" Background="#1E3B67"><TextBlock Text="02" FontSize="9" Foreground="#EAF1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Longitudinal insight" FontSize="14" FontWeight="Medium" Foreground="#F7FAFF"/><TextBlock Text="Review patient results across sessions." FontSize="12" Foreground="#B9C8E0" Margin="0,4,0,0"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="7" BorderBrush="#70A7FF" BorderThickness="1" Background="#1E3B67"><TextBlock Text="03" FontSize="9" Foreground="#EAF1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Cognitive practice" FontSize="14" FontWeight="Medium" Foreground="#F7FAFF"/><TextBlock Text="Make training part of the care journey." FontSize="12" Foreground="#B9C8E0" Margin="0,4,0,0"/></StackPanel></Grid></StackPanel></StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PRIVATE WORKSPACE  ·  SECURE SESSION" FontSize="10" FontWeight="SemiBold" Foreground="#91A8CE" VerticalAlignment="Center"/><Canvas Grid.Column="1" Width="118" Height="42"><Path Data="M 0,32 C 15,32 15,9 28,16 S 47,38 60,22 S 80,8 93,20 S 108,12 118,5" Stroke="#B3CAFF" StrokeThickness="1.4" Fill="Transparent" Opacity="0.8"/></Canvas></Grid>
        </Grid></Border>
        <Grid Grid.Column="1" Margin="28,24,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button x:Name="LanguageToggleBtn" Grid.Row="0" Width="48" Height="40" HorizontalAlignment="Right" FontSize="13" BorderBrush="#273247" BorderThickness="1" Background="#111827" Foreground="#F5F7FC" Cursor="Hand"/>
            <Border x:Name="CardBorder" Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="26" Padding="34" VerticalAlignment="Center" Margin="0,10"><Border.Effect><DropShadowEffect x:Name="CardShadow" BlurRadius="26" ShadowDepth="0" Opacity="0.06" Color="#000000"/></Border.Effect>
                <StackPanel x:Name="ContentPanel"><StackPanel.RenderTransform><TranslateTransform Y="12"/></StackPanel.RenderTransform><StackPanel.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/><DoubleAnimation Storyboard.TargetProperty="(StackPanel.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.35"/></Storyboard></BeginStoryboard></EventTrigger></StackPanel.Triggers>
                    <TextBlock Text="WELCOME BACK" FontSize="10" FontWeight="SemiBold" Foreground="#7EA9F7" Margin="0,0,0,12"/><TextBlock Text="Sign in to Focus AI" FontSize="30" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Continue to your clinical workspace." FontSize="14" Foreground="{DynamicResource TextSecBrush}" Margin="0,8,0,28"/>
                    <TextBlock Text="Email address" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBox x:Name="EmailTextBox"/></Border>
                    <Grid Margin="0,19,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"><Hyperlink Click="ForgotPasswordLink_Click" Foreground="#8DB6FF" TextDecorations="None">Forgot password?</Hyperlink></TextBlock></Grid><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><PasswordBox x:Name="PasswordBox"/></Border>
                    <CheckBox x:Name="RememberMeCheckBox" Content="Keep me signed in" Margin="0,15,0,0"/>
                    <Button x:Name="LoginButton" Content="Continue  →" Height="48" Margin="0,24,0,12" Style="{StaticResource AuthPrimaryButton}" Click="LoginButton_Click"/>
                    <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="OR CONTINUE WITH" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecBrush}" Margin="12,0"/><Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource DividerBrush}" VerticalAlignment="Center"/></Grid>
                    <Button x:Name="GoogleSignUpButton" Height="46" Style="{StaticResource AuthSecondaryButton}" Click="GoogleLoginButton_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="G" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/><TextBlock Text="Continue with Google" VerticalAlignment="Center"/></StackPanel></Button>
                    <TextBlock TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecBrush}" Margin="0,24,0,0"><Run Text="New to Focus AI?  "/><Hyperlink Click="SignUpLink_Click" Foreground="#8DB6FF" TextDecorations="None">Create an account</Hyperlink></TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="2" Text="FOCUS AI  ·  DESIGNED FOR CLINICAL CLARITY" FontSize="10" FontWeight="SemiBold" Foreground="#607087" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
