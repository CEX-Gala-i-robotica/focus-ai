<Window x:Class="focus_ai.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI · Profile settings" Width="900" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TxtSecondary}"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource TxtPrimary}"/></Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#F87171"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Visibility" Value="Collapsed"/></Style>
        <Style x:Key="PrimaryBtn" TargetType="Button"><Setter Property="Background" Value="{DynamicResource AccentPrimary}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="18,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="GhostBtn" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TxtSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BgInputBorder}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="18,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource BgCardHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Border x:Name="RootBorder" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="28" Margin="12" ClipToBounds="True">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.82*"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" Padding="30"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" HorizontalAlignment="Left"><TextBlock x:Name="HeaderInitials" Text="U" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="HeaderTitle" Text="Edit profile" FontSize="27" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,18,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SubHeaderEmail" Text="" FontSize="12" Foreground="{DynamicResource TxtSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,20"><TextBlock Text="ACCOUNT DETAILS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" Margin="0,0,0,12"/><TextBlock Text="Keep your professional profile accurate and ready for the next session." FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="27"/><TextBlock Text="Your name, contact information and office address are used to identify your clinical workspace." FontSize="13" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"/><Border Height="1" Background="{DynamicResource BgSep}" Margin="0,24,0,22"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="7" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}"><TextBlock Text="01" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Identity" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Name and date of birth" FontSize="11" Foreground="{DynamicResource TxtMuted}" Margin="0,3,0,0"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="7" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}"><TextBlock Text="02" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Contact" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Phone and office address" FontSize="11" Foreground="{DynamicResource TxtMuted}" Margin="0,3,0,0"/></StackPanel></Grid></StackPanel>
                <Button x:Name="LanguageToggleBtn" Grid.Row="2" Width="54" Height="38" HorizontalAlignment="Left" Background="{DynamicResource BgCard}" Foreground="{DynamicResource TxtPrimary}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Cursor="Hand" FontSize="13"/>
            </Grid></Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,30,32,28"><StackPanel><TextBlock Text="PERSONAL INFORMATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><TextBlock Text="Profile settings" FontSize="23" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,7,0,0"/><TextBlock Text="Update the fields below, then save your changes." FontSize="13" Foreground="{DynamicResource TxtSecondary}" Margin="0,5,0,24"/>
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="First name" Style="{StaticResource InputLabelStyle}"/><Border x:Name="BoxNameBorder" BorderBrush="{DynamicResource BgInputBorder}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource BgInput}"><TextBox x:Name="BoxName" Style="{StaticResource TextBoxStyle}" TextChanged="Name_Changed"/></Border><TextBlock x:Name="ErrName" Text="First name is required." Style="{StaticResource ErrorTextStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Last name" Style="{StaticResource InputLabelStyle}"/><Border x:Name="BoxSurnameBorder" BorderBrush="{DynamicResource BgInputBorder}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource BgInput}"><TextBox x:Name="BoxSurname" Style="{StaticResource TextBoxStyle}" TextChanged="Name_Changed"/></Border><TextBlock x:Name="ErrSurname" Text="Last name is required." Style="{StaticResource ErrorTextStyle}"/></StackPanel></Grid>
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Birth date" Style="{StaticResource InputLabelStyle}"/><Border x:Name="BoxBirthBorder" BorderBrush="{DynamicResource BgInputBorder}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource BgInput}" Padding="6,4"><DatePicker x:Name="BirthDatePicker" Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{DynamicResource TxtPrimary}" SelectedDateChanged="BirthDate_Changed" VerticalAlignment="Center" Height="34"><DatePicker.Resources><Style TargetType="DatePickerTextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DatePicker.Resources></DatePicker></Border><TextBlock x:Name="ErrBirth" Text="Birth date is required." Style="{StaticResource ErrorTextStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Phone number" Style="{StaticResource InputLabelStyle}"/><Border x:Name="BoxPhoneBorder" BorderBrush="{DynamicResource BgInputBorder}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource BgInput}"><TextBox x:Name="BoxPhone" Style="{StaticResource TextBoxStyle}" TextChanged="Phone_Changed"/></Border><TextBlock x:Name="ErrPhone" Text="Invalid format. Example: +40 722 000 000" Style="{StaticResource ErrorTextStyle}"/></StackPanel></Grid>
                <StackPanel Margin="0,0,0,24"><TextBlock Text="Office address" Style="{StaticResource InputLabelStyle}"/><Border x:Name="BoxAddressBorder" BorderBrush="{DynamicResource BgInputBorder}" BorderThickness="1" CornerRadius="11" Background="{DynamicResource BgInput}"><TextBox x:Name="BoxAddress" Style="{StaticResource TextBoxStyle}" TextChanged="Address_Changed"/></Border><TextBlock x:Name="ErrAddress" Text="Office address is required." Style="{StaticResource ErrorTextStyle}"/></StackPanel>
                <Border Height="1" Background="{DynamicResource BgSep}" Margin="0,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="CancelBtn" Grid.Column="0" Content="Cancel" Style="{StaticResource GhostBtn}" Click="Cancel_Click"/><Button x:Name="SaveBtn" Grid.Column="2" Content="Save changes  →" Style="{StaticResource PrimaryBtn}" Click="Save_Click"/></Grid>
            </StackPanel></ScrollViewer>
        </Grid>
    </Border>
</Window>
