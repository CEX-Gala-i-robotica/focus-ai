<Window x:Class="focus_ai.BuzzerTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI · Auditory reaction" Height="800" Width="1180"
        MinHeight="620" MinWidth="920" WindowState="Maximized" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="Background" Value="{DynamicResource AccentPrimary}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="24,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{DynamicResource BgRoot}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BgSep}" BorderThickness="0,0,1,0" Padding="54,42"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="#EAF2FF" BorderBrush="#BBD1F5" BorderThickness="1" Margin="0,0,12,0"><Image Source="pack://application:,,,/focusai.ico" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Focus AI" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="REACTION PROTOCOL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,18,20"><Border Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,22"><TextBlock Text="STAGE 03  /  AUDITORY RESPONSE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/></Border><TextBlock Text="Measure the moment between signal and response." FontSize="37" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="44"/><TextBlock Text="Wait for the sound cue. Respond as quickly and consistently as possible. The timer captures your response latency." FontSize="15" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="24"/><Canvas Height="160" Margin="0,36,0,0" ClipToBounds="True"><Line X1="0" Y1="35" X2="420" Y2="35" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Line X1="0" Y1="80" X2="420" Y2="80" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Line X1="0" Y1="125" X2="420" Y2="125" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Path Data="M 0,80 L 36,80 L 47,73 L 58,87 L 72,80 L 100,80 L 112,30 L 124,128 L 137,66 L 150,80 L 187,80 L 198,75 L 210,85 L 225,80 L 256,80 L 268,18 L 281,135 L 294,62 L 307,80 L 345,80 L 356,75 L 368,85 L 380,80 L 420,80" Stroke="#86B2FF" StrokeThickness="2" Fill="Transparent"/><Path Data="M 0,148 L 90,148 L 96,142 L 102,154 L 108,148 L 185,148 L 191,144 L 198,152 L 206,148 L 285,148 L 292,140 L 300,155 L 308,148 L 420,148" Stroke="#506A99" StrokeThickness="1.4" Fill="Transparent"/></Canvas></StackPanel><TextBlock Grid.Row="2" Text="FOCUS AI  ·  RESPONSE TIME MEASUREMENT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/></Grid></Border>
        <Grid Grid.Column="1" Margin="34,30,34,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ASSESSMENT STAGE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><TextBlock Text="Sound reaction" FontSize="26" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource TxtOnline}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource TxtSecondary}" VerticalAlignment="Center"/></StackPanel></Border></Grid>
            <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="28" Padding="30" Margin="0,22,0,22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="REACTION TIMER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/><TextBlock Text="Stay ready for the cue." FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource BgSection}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="11,7"><TextBlock Text="SOUND CUE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock Text="REACTION LATENCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center"/><TextBlock x:Name="TxtTimer" Text="0.000 s" FontSize="62" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,22,0,8"/><Border Height="1" Background="{DynamicResource BgSep}" Margin="12,18"/><TextBlock Text="Response latency" FontSize="12" Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="PROTOCOL STATUS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><Border x:Name="StatusBadge" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="11,6" HorizontalAlignment="Left" Margin="0,7,0,0"><TextBlock x:Name="TxtInstruction" Text="Press Start to begin the test" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtStatBlue}"/></Border></StackPanel><Button x:Name="BtnStart" Grid.Column="1" Content="Start test  →" Style="{StaticResource PrimaryButtonStyle}" MinWidth="155" VerticalAlignment="Center" Click="BtnStart_Click"/></Grid></Grid></Border>
            <TextBlock Grid.Row="2" Text="Follow the instructions and keep your hands ready to respond." FontSize="11" Foreground="{DynamicResource TxtMuted}" TextWrapping="Wrap" Margin="4,0,4,0"/>
        </Grid>
    </Grid>
</Window>
