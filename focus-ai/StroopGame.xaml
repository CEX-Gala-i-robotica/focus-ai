<Window x:Class="focus_ai.StroopGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI – Stroop Test" Height="660" Width="860"
        WindowState="Maximized"
        ResizeMode="CanMinimize">

    <Grid x:Name="RootGrid" Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="← Back"
                        FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource AccentSecBg}"
                        Foreground="{DynamicResource AccentSecFg}"
                        BorderThickness="0" Cursor="Hand"
                        Padding="14,8"
                        Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentSecHov}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="COGNITIVE PROTOCOL  /  02" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/>
                    <TextBlock Text="Stroop test" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Width="80"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="ScreenIntro" Visibility="Visible" Background="{DynamicResource BgRoot}">
                <Grid Margin="52,38,52,44">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Left">
                        <TextBlock Text="SELECTIVE ATTENTION  /  PROTOCOL 02" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,18" TextAlignment="Left"/>
                        <TextBlock Text="See the color. Ignore the word." FontSize="42" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="48" TextAlignment="Left"/>
                        <TextBlock Text="This task measures how consistently you can suppress an automatic response and focus on the relevant visual signal." FontSize="15" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,28" MaxWidth="540" HorizontalAlignment="Left" TextAlignment="Left"/>
                        <TextBlock Text="THE PROTOCOL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,14" TextAlignment="Left"/>
                        <Grid Margin="0,0,0,13" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="13" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Top" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="A color word appears on screen." FontSize="14" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" TextAlignment="Left"/></Grid>
                        <Grid Margin="0,0,0,13" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="13" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Top" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Respond to the ink color, not the word's meaning." FontSize="14" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" TextAlignment="Left"/></Grid>
                        <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" FontSize="13" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Top" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Complete 30 trials with speed and accuracy." FontSize="14" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" TextAlignment="Left"/></Grid>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="30" Padding="30" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SESSION SETUP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><Border Grid.Column="1" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5"><TextBlock Text="30 TRIALS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border></Grid>
                            <Border Background="{DynamicResource BgSection}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,22,0,26"><StackPanel><TextBlock Text="SAMPLE STIMULUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><TextBlock Text="BLUE" FontSize="42" FontWeight="Medium" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,14,0,8"/><TextBlock Text="Name the ink color, not the word." FontSize="12" Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
                            <TextBlock Text="DIFFICULTY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26"><RadioButton x:Name="DiffEasy" Content="Easy" GroupName="Diff" IsChecked="True" Foreground="{DynamicResource TxtPrimary}" Cursor="Hand" Margin="0,0,22,0"/><RadioButton x:Name="DiffMedium" Content="Medium" GroupName="Diff" Foreground="{DynamicResource TxtPrimary}" Cursor="Hand" Margin="0,0,22,0"/><RadioButton x:Name="DiffHard" Content="Hard" GroupName="Diff" Foreground="{DynamicResource TxtPrimary}" Cursor="Hand"/></StackPanel>
                            <Button x:Name="BtnStart" Content="Begin assessment  →" Click="BtnStart_Click" Background="{DynamicResource AccentPrimary}" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Padding="22,13" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Your performance is recorded in the assessment history." FontSize="11" Foreground="{DynamicResource TxtMuted}" TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ScreenGame" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgSidebar}"
                            Padding="24,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtProgress"
                                               Text="Round 1 / 30"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TxtMuted}"/>
                                    <TextBlock x:Name="TxtDifficulty"
                                               Text="Easy"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TxtMuted}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="6" CornerRadius="3"
                                        Background="{DynamicResource BgNavHover}">
                                    <Border x:Name="ProgressBar" Height="6" CornerRadius="3"
                                            Background="{DynamicResource AccentPrimary}"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTimer" Text="∞"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{DynamicResource TxtPrimary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="sec" FontSize="9"
                                           Foreground="{DynamicResource TxtMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SCORE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TxtMuted}"
                                           HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtScore" Text="0"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource TxtPrimary}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border x:Name="StreakBadge" Background="{DynamicResource BgStatOrange}"
                                    CornerRadius="20" Padding="14,6"
                                    HorizontalAlignment="Center" Margin="0,0,0,20"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TxtStreak" Text="3 in a row"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TxtStatOrange}"/>
                            </Border>

                            <TextBlock x:Name="WordLabel" Text="RED"
                                       FontSize="72" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,50"/>

                            <Grid x:Name="ButtonGrid" Width="500">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="Btn0" Grid.Column="0" Grid.Row="0"
                                        Height="60" FontSize="16" FontWeight="Bold"
                                        BorderThickness="2" Cursor="Hand" Click="Answer_Click" Tag="0"/>
                                <Button x:Name="Btn1" Grid.Column="2" Grid.Row="0"
                                        Height="60" FontSize="16" FontWeight="Bold"
                                        BorderThickness="2" Cursor="Hand" Click="Answer_Click" Tag="1"/>
                                <Button x:Name="Btn2" Grid.Column="0" Grid.Row="2"
                                        Height="60" FontSize="16" FontWeight="Bold"
                                        BorderThickness="2" Cursor="Hand" Click="Answer_Click" Tag="2"/>
                                <Button x:Name="Btn3" Grid.Column="2" Grid.Row="2"
                                        Height="60" FontSize="16" FontWeight="Bold"
                                        BorderThickness="2" Cursor="Hand" Click="Answer_Click" Tag="3"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="28,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="CORRECT  /  " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/>
                                <TextBlock x:Name="TxtCorrect" Text="0 correct"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#22C55E" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="INCORRECT  /  " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/>
                                <TextBlock x:Name="TxtWrong" Text="0 wrong"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#EF4444" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ScreenResults" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="WinOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border CornerRadius="24" Padding="48,40" Background="{DynamicResource BgCard}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="WinEmoji" Text="SESSION COMPLETE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="WinTitle" Text="Excellent!" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TxtPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="WinSubtitle" Text=""
                               FontSize="14" Foreground="{DynamicResource TxtSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WinScore" Text="Final score: 0 / 100"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentSecFg}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Play again  →"
                                Click="WinPlayAgain_Click"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White" FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18" Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="← Back to menu"
                                Click="BackButton_Click"
                                Background="{DynamicResource AccentSecBg}"
                                Foreground="{DynamicResource AccentSecFg}"
                                FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18" Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSecHov}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>