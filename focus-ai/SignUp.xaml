<Window x:Class="focus_ai.SignUp" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus AI · Create account" Height="860" Width="1160" MinHeight="760" MinWidth="1040" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Color x:Key="LightWindowBg">#F4F6FB</Color><Color x:Key="LightCardBg">#FFFFFF</Color><Color x:Key="LightTextPrimary">#111827</Color><Color x:Key="LightTextSecondary">#64748B</Color><Color x:Key="LightBorder">#E2E8F0</Color><Color x:Key="LightInputBg">#F8FAFC</Color><Color x:Key="LightDivider">#E2E8F0</Color>
        <Color x:Key="DarkWindowBg">#0B0F19</Color><Color x:Key="DarkCardBg">#111827</Color><Color x:Key="DarkTextPrimary">#F5F7FC</Color><Color x:Key="DarkTextSecondary">#A6B0C2</Color><Color x:Key="DarkBorder">#273247</Color><Color x:Key="DarkInputBg">#0D1422</Color><Color x:Key="DarkDivider">#273247</Color>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource DarkCardBg}"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/><SolidColorBrush x:Key="TextSecBrush" Color="{StaticResource DarkTextSecondary}"/><SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/><SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource DarkInputBg}"/><SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DarkDivider}"/>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="DM Sans, Segoe UI"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="DM Sans, Segoe UI"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="AuthPrimaryButton" TargetType="Button"><Setter Property="Background" Value="#F5F7FC"/><Setter Property="Foreground" Value="#101725"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="18,12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="AuthSecondaryButton" TargetType="Button"><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#F5F7FC"/><Setter Property="FontSize" Value="13"/><Setter Property="BorderBrush" Value="#2C374A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14,11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5D83C7"/><Setter TargetName="Surface" Property="Background" Value="#172338"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Window.Background><SolidColorBrush x:Name="WindowBackground" Color="{StaticResource DarkWindowBg}"/></Window.Background>
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#111827" BorderBrush="#273247" BorderThickness="1" CornerRadius="30" ClipToBounds="True" Padding="38"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="#EAF2FF" BorderBrush="#BBD1F5" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0"><Image Source="pack://application:,,,/focusai.ico" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Focus AI" FontSize="20" FontWeight="SemiBold" Foreground="#F5F7FC"/><TextBlock Text="CLINICAL INTELLIGENCE" FontSize="10" FontWeight="SemiBold" Foreground="#8798B4" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="A more connected way to care." FontSize="35" FontWeight="Medium" Foreground="#F7FAFF" TextWrapping="Wrap" LineHeight="42"/><TextBlock Text="Create a secure workspace for structured cognitive assessment and patient progress." FontSize="14" Foreground="#A6B6CD" TextWrapping="Wrap" Margin="0,16,0,26" LineHeight="23"/><Border BorderBrush="#273247" BorderThickness="1" CornerRadius="18" Padding="18" Background="#0D1422"><StackPanel><TextBlock Text="YOUR WORKSPACE INCLUDES" FontSize="10" FontWeight="SemiBold" Foreground="#7EA9F7" Margin="0,0,0,16"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="12" Foreground="#7EA9F7" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Patient profiles" FontSize="14" FontWeight="Medium" Foreground="#E8EEF8"/><TextBlock Text="Keep contact and clinical history together." FontSize="12" Foreground="#8798B4" Margin="0,4,0,0"/></StackPanel></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="12" Foreground="#7EA9F7" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Multidimensional assessments" FontSize="14" FontWeight="Medium" Foreground="#E8EEF8"/><TextBlock Text="Eye movement, response and attention tasks." FontSize="12" Foreground="#8798B4" Margin="0,4,0,0"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" FontSize="12" Foreground="#7EA9F7" FontWeight="SemiBold"/><StackPanel Grid.Column="1"><TextBlock Text="Progress over time" FontSize="14" FontWeight="Medium" Foreground="#E8EEF8"/><TextBlock Text="Turn results into a clearer longitudinal picture." FontSize="12" Foreground="#8798B4" Margin="0,4,0,0"/></StackPanel></Grid></StackPanel></Border></StackPanel><TextBlock Grid.Row="2" Text="PRIVATE WORKSPACE  ·  DESIGNED FOR CLINICAL CLARITY" FontSize="9" FontWeight="SemiBold" Foreground="#6E7F99"/></Grid></Border>
        <Grid Grid.Column="1" Margin="26,18,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button x:Name="LanguageToggleBtn" Width="46" Height="38" HorizontalAlignment="Right" FontSize="13" BorderBrush="#273247" BorderThickness="1" Background="#111827" Foreground="#F5F7FC" Cursor="Hand"/><Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="26" Padding="28" Margin="0,10"><Border.Effect><DropShadowEffect x:Name="CardShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.06" Color="#000000"/></Border.Effect><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="GET STARTED" FontSize="10" FontWeight="SemiBold" Foreground="#7EA9F7" Margin="0,0,0,10"/><TextBlock Text="Create your account" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="A few details to set up your clinical workspace." FontSize="13" Foreground="{DynamicResource TextSecBrush}" Margin="0,7,0,22"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="First name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><TextBox x:Name="NameTextBox"/></Border></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Last name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><TextBox x:Name="SurnameTextBox"/></Border></StackPanel></Grid>
            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Date of birth" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/><DatePicker x:Name="BirthDatePicker"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Phone number" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><TextBox x:Name="PhoneTextBox"/></Border></StackPanel></Grid>
            <TextBlock Text="Cabinet address" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,6"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><TextBox x:Name="CabinetAddressTextBox"/></Border>
            <TextBlock Text="Email address" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,6"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><TextBox x:Name="EmailTextBox"/></Border>
            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,6"/><Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><PasswordBox x:Name="PasswordBox"/></Border>
            <Button x:Name="SignUpButton" Content="Create account  →" Height="46" Margin="0,22,0,10" Style="{StaticResource AuthPrimaryButton}" Click="SignUpButton_Click"/><Button x:Name="GoogleSignUpButton" Height="44" Style="{StaticResource AuthSecondaryButton}" Click="GoogleSignUpButton_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="G" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/><TextBlock Text="Continue with Google" VerticalAlignment="Center"/></StackPanel></Button>
            <TextBlock TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecBrush}" Margin="0,18,0,0"><Run Text="Already have an account?  "/><Hyperlink Click="LoginLink_Click" Foreground="#8DB6FF" TextDecorations="None">Sign in</Hyperlink></TextBlock></StackPanel></ScrollViewer></Border><TextBlock Grid.Row="2" Text="By continuing, you agree to use patient data responsibly." FontSize="10" Foreground="#718096" TextAlignment="Center" Margin="0,6,0,0"/></Grid>
    </Grid>
</Window>
