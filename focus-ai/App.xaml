<Application x:Class="focus_ai.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!--
            IMPORTANT: Toate brush-urile TREBUIE să existe aici înainte ca
            orice fereastră să se deschidă. ThemeManager.Apply() va modifica
            .Color pe aceste obiecte — DynamicResource se actualizează automat.
            
            Valorile de mai jos = tema DARK (default la startup).
            App.xaml.cs apelează ThemeManager.Apply(isDark) în OnStartup.
        -->

        <!-- Tipografie -->
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style x:Key="KickerTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Fonduri -->
        <SolidColorBrush x:Key="BgRoot"        Color="#0B0F19"/>
        <SolidColorBrush x:Key="BgSidebar"     Color="#0D1220"/>
        <SolidColorBrush x:Key="BgMain"        Color="#0B0F19"/>
        <SolidColorBrush x:Key="BgCard"        Color="#1A2035"/>
        <SolidColorBrush x:Key="BgCardHover"   Color="#222C46"/>
        <SolidColorBrush x:Key="BgNavActive"   Color="#182036"/>
        <SolidColorBrush x:Key="BgNavHover"    Color="#151C2E"/>
        <SolidColorBrush x:Key="BgUserBar"     Color="#111827"/>
        <SolidColorBrush x:Key="BgSep"         Color="#252D41"/>
        <SolidColorBrush x:Key="BgToggle"      Color="#171F33"/>
        <SolidColorBrush x:Key="BgSection"     Color="#111827"/>
        <SolidColorBrush x:Key="BgInput"       Color="#111827"/>
        <SolidColorBrush x:Key="BgInputBorder" Color="#252D41"/>

        <!-- Stat cards -->
        <SolidColorBrush x:Key="BgStatBlue"    Color="#1A2035"/>
        <SolidColorBrush x:Key="BgStatGreen"   Color="#1A2035"/>
        <SolidColorBrush x:Key="BgStatPurple"  Color="#1A2035"/>
        <SolidColorBrush x:Key="BgStatOrange"  Color="#1A2035"/>

        <!-- Texte -->
        <SolidColorBrush x:Key="TxtPrimary"    Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TxtSecondary"  Color="#A0AEC0"/>
        <SolidColorBrush x:Key="TxtMuted"      Color="#718096"/>
        <SolidColorBrush x:Key="TxtNavActive"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TxtOnline"     Color="#22C55E"/>

        <!-- Stat labels -->
        <SolidColorBrush x:Key="TxtStatBlue"   Color="#60A5FA"/>
        <SolidColorBrush x:Key="TxtStatGreen"  Color="#4ADE80"/>
        <SolidColorBrush x:Key="TxtStatPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="TxtStatOrange" Color="#FB923C"/>

        <!-- Accent -->
        <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover"   Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSecBg"   Color="#172036"/>
        <SolidColorBrush x:Key="AccentSecFg"   Color="#60A5FA"/>
        <SolidColorBrush x:Key="AccentSecHov"  Color="#222C46"/>

        <!-- Rânduri tabel -->
        <SolidColorBrush x:Key="RowBg"         Color="Transparent"/>
        <SolidColorBrush x:Key="RowHover"      Color="#222C46"/>
        <SolidColorBrush x:Key="RowBorder"     Color="#252D41"/>
        <SolidColorBrush x:Key="RowNumBg"      Color="#161B2C"/>

        <!-- Game cards -->
        <SolidColorBrush x:Key="GameCard1Bg"     Color="#1A2035"/>
        <SolidColorBrush x:Key="GameCard2Bg"     Color="#1A2035"/>
        <SolidColorBrush x:Key="GameCard3Bg"     Color="#1A2035"/>
        <SolidColorBrush x:Key="GameCard4Bg"     Color="#1A2035"/>
        <SolidColorBrush x:Key="GameCard5Bg"     Color="#1A2035"/>
        <SolidColorBrush x:Key="GameCardLockBg"  Color="#111827"/>

    </Application.Resources>
</Application>
