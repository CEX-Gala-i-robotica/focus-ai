<Application x:Class="focus_ai.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="AppFontFamily">DM Sans, Geist, Segoe UI Variable Display, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="BgRoot" Color="#0B0F19"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#0D1220"/>
        <SolidColorBrush x:Key="BgMain" Color="#0B0F19"/>
        <SolidColorBrush x:Key="BgCard" Color="#151C2C"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1B2740"/>
        <SolidColorBrush x:Key="BgNavActive" Color="#18253C"/>
        <SolidColorBrush x:Key="BgNavHover" Color="#151D2F"/>
        <SolidColorBrush x:Key="BgUserBar" Color="#101827"/>
        <SolidColorBrush x:Key="BgSep" Color="#273247"/>
        <SolidColorBrush x:Key="BgToggle" Color="#151D2F"/>
        <SolidColorBrush x:Key="BgSection" Color="#101827"/>
        <SolidColorBrush x:Key="BgInput" Color="#111827"/>
        <SolidColorBrush x:Key="BgInputBorder" Color="#273247"/>
        <SolidColorBrush x:Key="BgStatBlue" Color="#151C2C"/>
        <SolidColorBrush x:Key="BgStatGreen" Color="#151C2C"/>
        <SolidColorBrush x:Key="BgStatPurple" Color="#151C2C"/>
        <SolidColorBrush x:Key="BgStatOrange" Color="#151C2C"/>
        <SolidColorBrush x:Key="TxtPrimary" Color="#F5F7FC"/>
        <SolidColorBrush x:Key="TxtSecondary" Color="#A6B0C2"/>
        <SolidColorBrush x:Key="TxtMuted" Color="#7E8AA0"/>
        <SolidColorBrush x:Key="TxtVersion" Color="#7E8AA0"/>
        <SolidColorBrush x:Key="TxtNavActive" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TxtOnline" Color="#22C55E"/>
        <SolidColorBrush x:Key="TxtStatBlue" Color="#91B9FF"/>
        <SolidColorBrush x:Key="TxtStatGreen" Color="#8CCFB2"/>
        <SolidColorBrush x:Key="TxtStatPurple" Color="#B5ACF8"/>
        <SolidColorBrush x:Key="TxtStatOrange" Color="#DAB58D"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSecBg" Color="#17243B"/>
        <SolidColorBrush x:Key="AccentSecFg" Color="#8BB7FF"/>
        <SolidColorBrush x:Key="AccentSecHov" Color="#202F4A"/>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#3159BE" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E5935" Offset="0"/>
            <GradientStop Color="#383F7D" Offset="0.52"/>
            <GradientStop Color="#255EB0" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="RowBg" Color="#00000000"/>
        <SolidColorBrush x:Key="RowHover" Color="#18243A"/>
        <SolidColorBrush x:Key="RowBorder" Color="#273247"/>
        <SolidColorBrush x:Key="RowNumBg" Color="#1B263B"/>
        <SolidColorBrush x:Key="GameCard1Bg" Color="#151C2C"/>
        <SolidColorBrush x:Key="GameCard2Bg" Color="#151C2C"/>
        <SolidColorBrush x:Key="GameCard3Bg" Color="#151C2C"/>
        <SolidColorBrush x:Key="GameCard4Bg" Color="#151C2C"/>
        <SolidColorBrush x:Key="GameCard5Bg" Color="#151C2C"/>
        <SolidColorBrush x:Key="GameCardLockBg" Color="#101827"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.08" Color="#000000"/>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Background" Value="{DynamicResource BgRoot}"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style x:Key="KickerTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TxtMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Compact vector navigation used by the dashboard's floating sidebar. -->
        <Style x:Key="RefinedNavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="9,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="IconSurface" Width="30" Height="30" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Viewbox Width="17" Height="17" Stretch="Uniform">
                                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource BgNavActive}"/><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource BgSep}"/><Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource AccentPrimary}"/><Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource BgNavHover}"/><Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource AccentSecBg}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgSep}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource BgCardHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource TxtPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource BgInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextBoxSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource TxtPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource BgInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="PasswordSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PasswordSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PasswordSurface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="RadioOuter" Width="15" Height="15" CornerRadius="8" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgInput}" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioDot" Width="6" Height="6" Fill="{DynamicResource AccentPrimary}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/><Setter TargetName="RadioOuter" Property="Background" Value="{DynamicResource AccentSecBg}"/><Setter TargetName="RadioDot" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource AccentSecFg}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgSep}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TxtSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </Application.Resources>
</Application>
