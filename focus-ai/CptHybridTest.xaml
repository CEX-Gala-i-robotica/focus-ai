<Window x:Class="focus_ai.CptHybridTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI - Hybrid CPT"
        Height="620" Width="900"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="PrimaryClinicalButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostClinicalButton" TargetType="Button" BasedOn="{StaticResource PrimaryClinicalButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#111827"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="38,22,38,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Hybrid CPT - Attention &amp; Inhibitory Control Test"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#E5E7EB"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="PROGRESS" FontSize="10" FontWeight="SemiBold"
                               Foreground="#64748B" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ProgressText"
                               Text="Trial 0 / 50"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#60A5FA"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="38,22">
            <Border Background="#111827" BorderBrush="#1F2937"
                    BorderThickness="1" CornerRadius="6" Padding="30">
                <Grid>
                    <Grid x:Name="InstructionsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Hybrid CPT - Attention &amp; Inhibitory Control Test"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       Margin="0,0,0,14"/>
                            <TextBlock Text="In this test, letters will appear one at a time on the screen."
                                       FontSize="16" Foreground="#CBD5E1"
                                       Margin="0,0,0,16"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Press SPACE:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#E5E7EB" Margin="0,0,0,10"/>
                                <TextBlock Text="- when X appears after A"
                                           FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,18"/>

                                <TextBlock Text="Respond:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#E5E7EB" Margin="0,0,0,10"/>
                                <TextBlock Text="- as quickly as possible"
                                           FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBlock Text="- but as accurately as possible"
                                           FontSize="14" Foreground="#CBD5E1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Do NOT press:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#E5E7EB" Margin="0,0,0,10"/>
                                <TextBlock Text="- for other letters"
                                           FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBlock Text="- for X after letters other than A (example: BX, CX)"
                                           FontSize="14" Foreground="#CBD5E1" TextWrapping="Wrap"
                                           Margin="0,0,0,18"/>

                                <TextBlock Text="The test measures:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#E5E7EB" Margin="0,0,0,10"/>
                                <TextBlock Text="- attention"
                                           FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBlock Text="- reaction speed"
                                           FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBlock Text="- impulse control"
                                           FontSize="14" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBlock Text="- working memory"
                                           FontSize="14" Foreground="#CBD5E1"/>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Content="Start"
                                Style="{StaticResource PrimaryClinicalButton}"
                                HorizontalAlignment="Right"
                                Click="StartButton_Click"/>
                    </Grid>

                    <Grid x:Name="TrialPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Text="Fixation"
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="StimulusText"
                                   Grid.Row="1"
                                   Text="+"
                                   FontSize="168"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"/>

                        <TextBlock x:Name="FeedbackText"
                                   Grid.Row="2"
                                   Text=""
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#60A5FA"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Results Dashboard"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   Margin="0,0,0,24"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="2" Rows="4">
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Accuracy" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultAccuracyText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Mean Reaction Time" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultMeanRtText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Hit Rate" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultHitRateText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="False Alarm Rate" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultFalseAlarmRateText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Total Hits" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultHitsText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Total Misses" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultMissesText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Total False Alarms" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultFalseAlarmsText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Correct Rejections" Foreground="#94A3B8" FontSize="12"/>
                                    <TextBlock x:Name="ResultCorrectRejectionsText" Text="-" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            </ScrollViewer>

                            <Border Grid.Column="2" Background="#0F172A"
                                    BorderBrush="#1F2937" BorderThickness="1"
                                    CornerRadius="6" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Automatic Interpretation"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="#E5E7EB"
                                               Margin="0,0,0,14"/>
                                    <TextBlock x:Name="ResultInterpretationText"
                                               Text="-"
                                               FontSize="14"
                                               Foreground="#CBD5E1"
                                               TextWrapping="Wrap"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Grid.Row="2"
                                Content="Finish"
                                Style="{StaticResource PrimaryClinicalButton}"
                                HorizontalAlignment="Right"
                                Click="Finish_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0F172A" Padding="38,16,38,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource GhostClinicalButton}"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
