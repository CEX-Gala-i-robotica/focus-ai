<Window x:Class="focus_ai.CptHybridTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI - Hybrid CPT"
        Height="620" Width="900"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="PrimaryClinicalButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="{DynamicResource TxtMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostClinicalButton" TargetType="Button" BasedOn="{StaticResource PrimaryClinicalButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BgSep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BgCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="38,22,38,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Hybrid CPT - Attention &amp; Inhibitory Control Test"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="PROGRESS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ProgressText"
                               Text="Trial 0 / 50"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentSecFg}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="38,22">
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}"
                    BorderThickness="1" CornerRadius="18" Padding="30">
                <Grid>
                    <Grid x:Name="InstructionsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="ATTENTION  /  INHIBITORY CONTROL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,12"/>
                            <TextBlock Text="Respond to the target sequence." FontSize="34" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="Letters appear one at a time. Respond only when X follows A, and withhold responses to all other combinations." FontSize="15" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,20"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Press SPACE:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TxtPrimary}" Margin="0,0,0,10"/>
                                <TextBlock Text="- when X appears after A"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,0,0,18"/>

                                <TextBlock Text="Respond:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TxtPrimary}" Margin="0,0,0,10"/>
                                <TextBlock Text="- as quickly as possible"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,0,0,6"/>
                                <TextBlock Text="- but as accurately as possible"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Do NOT press:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TxtPrimary}" Margin="0,0,0,10"/>
                                <TextBlock Text="- for other letters"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,0,0,6"/>
                                <TextBlock Text="- for X after letters other than A (example: BX, CX)"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap"
                                           Margin="0,0,0,18"/>

                                <TextBlock Text="The test measures:"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TxtPrimary}" Margin="0,0,0,10"/>
                                <TextBlock Text="- attention"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,0,0,6"/>
                                <TextBlock Text="- reaction speed"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,0,0,6"/>
                                <TextBlock Text="- impulse control"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,0,0,6"/>
                                <TextBlock Text="- working memory"
                                           FontSize="14" Foreground="{DynamicResource TxtSecondary}"/>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Content="Start"
                                Style="{StaticResource PrimaryClinicalButton}"
                                HorizontalAlignment="Right"
                                Click="StartButton_Click"/>
                    </Grid>

                    <Grid x:Name="TrialPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Text="Fixation"
                                   FontSize="14"
                                   Foreground="{DynamicResource TxtMuted}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="StimulusText"
                                   Grid.Row="1"
                                   Text="+"
                                   FontSize="168"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TxtPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"/>

                        <TextBlock x:Name="FeedbackText"
                                   Grid.Row="2"
                                   Text=""
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentSecFg}"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Results Dashboard"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TxtPrimary}"
                                   Margin="0,0,0,24"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="2" Rows="4">
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Accuracy" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultAccuracyText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Mean Reaction Time" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultMeanRtText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Hit Rate" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultHitRateText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="False Alarm Rate" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultFalseAlarmRateText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Total Hits" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultHitsText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Total Misses" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultMissesText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Total False Alarms" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultFalseAlarmsText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,18">
                                    <TextBlock Text="Correct Rejections" Foreground="{DynamicResource TxtMuted}" FontSize="12"/>
                                    <TextBlock x:Name="ResultCorrectRejectionsText" Text="-" Foreground="{DynamicResource TxtPrimary}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            </ScrollViewer>

                            <Border Grid.Column="2" Background="{DynamicResource BgSidebar}"
                                    BorderBrush="{DynamicResource BgSep}" BorderThickness="1"
                                    CornerRadius="18" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Automatic Interpretation"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TxtPrimary}"
                                               Margin="0,0,0,14"/>
                                    <TextBlock x:Name="ResultInterpretationText"
                                               Text="-"
                                               FontSize="14"
                                               Foreground="{DynamicResource TxtSecondary}"
                                               TextWrapping="Wrap"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Grid.Row="2"
                                Content="Finish"
                                Style="{StaticResource PrimaryClinicalButton}"
                                HorizontalAlignment="Right"
                                Click="Finish_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="38,16,38,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource GhostClinicalButton}"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
