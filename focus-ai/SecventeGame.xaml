<Window x:Class="focus_ai.SecventeGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI - Sequences"
        Height="700" Width="900"
        WindowState="Maximized"
        ResizeMode="CanMinimize">

    <Grid x:Name="RootGrid" Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="← Back"
                        FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource AccentSecBg}"
                        Foreground="{DynamicResource AccentSecFg}"
                        BorderThickness="0" Cursor="Hand"
                        Padding="14,8"
                        Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentSecHov}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="COGNITIVE PROTOCOL  /  04" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/>
                    <TextBlock Text="Sequences" FontSize="19" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgStatBlue}"
                            CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="LEVEL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LevelText" Text="1"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgStatGreen}"
                            CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="SCORE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ScoreText" Text="0"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgStatOrange}"
                            CornerRadius="10" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="LIVES" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LivesText" Text="3 / 3"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="ScreenMenu" Visibility="Visible" Background="{DynamicResource BgRoot}">
                <Grid Margin="52,38,52,44"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Left">
                        <TextBlock Text="SEQUENTIAL MEMORY  /  PROTOCOL 04" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,18" TextAlignment="Left"/>
                        <TextBlock Text="Hold the sequence. Rebuild the pattern." FontSize="42" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="48" TextAlignment="Left"/>
                        <TextBlock Text="A cue sequence is shown one step at a time. Reproduce it in the same order; each new level adds another item to working memory." FontSize="15" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,28" MaxWidth="530" HorizontalAlignment="Left" TextAlignment="Left"/>
                        <TextBlock Text="SESSION STRUCTURE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,14" TextAlignment="Left"/>
                        <Grid Margin="0,0,0,13" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="13" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Observe the highlighted cue sequence." FontSize="14" Foreground="{DynamicResource TxtPrimary}" TextAlignment="Left"/></Grid>
                        <Grid Margin="0,0,0,13" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="13" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Repeat the cues in the exact same order." FontSize="14" Foreground="{DynamicResource TxtPrimary}" TextAlignment="Left"/></Grid>
                        <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" FontSize="13" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Progress through up to 20 levels; three errors end the session." FontSize="14" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" TextAlignment="Left"/></Grid>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="30" Padding="30" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SESSION SETUP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><Border Grid.Column="1" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5"><TextBlock Text="UP TO 20 LEVELS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border></Grid>
                            <Border Background="{DynamicResource BgSection}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,22,0,26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="MEMORY LOAD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"><Border Width="44" Height="54" CornerRadius="12" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}" Margin="0,0,8,0"><TextBlock Text="A" FontSize="22" Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="44" Height="54" CornerRadius="12" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}" Margin="0,0,8,0"><TextBlock Text="B" FontSize="22" Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="44" Height="54" CornerRadius="12" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1" Background="{DynamicResource BgNavActive}" Margin="0,0,8,0"><TextBlock Text="C" FontSize="22" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="→" FontSize="19" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/><Border Width="44" Height="54" CornerRadius="12" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}" Margin="10,0,0,0"><TextBlock Text="A" FontSize="22" Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="44" Height="54" CornerRadius="12" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}" Margin="8,0,0,0"><TextBlock Text="B" FontSize="22" Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="44" Height="54" CornerRadius="12" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" Background="{DynamicResource BgCard}" Margin="8,0,0,0"><TextBlock Text="C" FontSize="22" Foreground="{DynamicResource TxtSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Grid></Border>
                            <TextBlock Text="DIFFICULTY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26"><RadioButton x:Name="DiffEasy" Content="Easy" GroupName="Difficulty" IsChecked="True" Foreground="{DynamicResource TxtPrimary}" Cursor="Hand" Margin="0,0,20,0"/><RadioButton x:Name="DiffMedium" Content="Medium" GroupName="Difficulty" Foreground="{DynamicResource TxtPrimary}" Cursor="Hand" Margin="0,0,20,0"/><RadioButton x:Name="DiffHard" Content="Hard" GroupName="Difficulty" Foreground="{DynamicResource TxtPrimary}" Cursor="Hand"/></StackPanel>
                            <Button Content="Begin sequence test  →" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" Padding="22,13" Click="StartGame_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="ScreenGame" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="{DynamicResource BgCard}"
                            CornerRadius="12" Padding="24,12"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                        <TextBlock x:Name="StatusMessage"
                                   Text="Watch the sequence..."
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TxtPrimary}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Margin="0,0,0,28" Width="400">
                        <Border Background="{DynamicResource BgCard}"
                                CornerRadius="4" Height="6"/>
                        <Border x:Name="ProgressBar"
                                Background="#3B82F6"
                                CornerRadius="4" Height="6"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Grid>

                    <Grid x:Name="ButtonGrid" Width="360" Height="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="Btn0" Grid.Row="0" Grid.Column="0" Tag="0" Click="SeqButton_Click"/>
                        <Button x:Name="Btn1" Grid.Row="0" Grid.Column="2" Tag="1" Click="SeqButton_Click"/>
                        <Button x:Name="Btn2" Grid.Row="0" Grid.Column="4" Tag="2" Click="SeqButton_Click"/>
                        <Button x:Name="Btn3" Grid.Row="2" Grid.Column="0" Tag="3" Click="SeqButton_Click"/>
                        <Button x:Name="Btn4" Grid.Row="2" Grid.Column="2" Tag="4" Click="SeqButton_Click"/>
                        <Button x:Name="Btn5" Grid.Row="2" Grid.Column="4" Tag="5" Click="SeqButton_Click"/>
                        <Button x:Name="Btn6" Grid.Row="4" Grid.Column="0" Tag="6" Click="SeqButton_Click"/>
                        <Button x:Name="Btn7" Grid.Row="4" Grid.Column="2" Tag="7" Click="SeqButton_Click"/>
                        <Button x:Name="Btn8" Grid.Row="4" Grid.Column="4" Tag="8" Click="SeqButton_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="WinOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border CornerRadius="24" Padding="48,40" Background="{DynamicResource BgCard}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="WinEmoji" Text="SESSION COMPLETE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="WinTitle" Text="Excellent!" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TxtPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="WinSubtitle" Text=""
                               FontSize="14" Foreground="{DynamicResource TxtSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WinScore" Text="Final score: 0"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentSecFg}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="🔄  Play again"
                                Click="WinPlayAgain_Click"
                                Background="{DynamicResource AccentPrimary}"
                                Foreground="White" FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18" Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="🏠  Main menu"
                                Click="WinGoMenu_Click"
                                Background="{DynamicResource AccentSecBg}"
                                Foreground="{DynamicResource AccentSecFg}"
                                FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18" Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSecHov}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>