<Window x:Class="focus_ai.TrendAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Cognitive trend analysis"
        Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Shared local styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSecBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSecFg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSecHov}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitlePatient" Text="Patient: loading..." 
                               FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TxtPrimary}"/>
                    <TextBlock Text="ML-based cognitive trend analysis" 
                               FontSize="12" Foreground="{DynamicResource TxtSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⟳ Refresh" 
                        Style="{StaticResource PrimaryButtonStyle}" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <!-- Graph card -->
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Test score evolution" FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TxtPrimary}" Margin="0,0,0,12"/>
                        <oxy:PlotView x:Name="TrendPlot" Height="350" Margin="0,0,0,12"/>
                        <TextBlock x:Name="PredictionAnnotation" FontSize="12" 
                                   Foreground="{DynamicResource TxtSecondary}" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Metrics Grid -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="PREDICTED SCORE" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="PredictedScoreValue" Text="—" Style="{StaticResource MetricValue}"/>
                            <TextBlock x:Name="ConfidenceRange" FontSize="11" Foreground="{DynamicResource TxtSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TREND" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TrendLabel" Text="—" Style="{StaticResource MetricValue}"/>
                            <TextBlock x:Name="TrendPerSession" FontSize="11" Foreground="{DynamicResource TxtSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MODEL CONFIDENCE" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="ConfidenceLevel" Text="—" Style="{StaticResource MetricValue}"/>
                            <TextBlock x:Name="MAEValue" FontSize="11" Foreground="{DynamicResource TxtSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SESSIONS ANALYZED" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="SessionsCount" Text="—" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ML Details -->
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Prediction details (ensemble)" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TxtPrimary}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Linear regression" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/>
                                <TextBlock x:Name="LinearRegrScore" Text="—" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TxtPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Holt smoothing" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/>
                                <TextBlock x:Name="HoltScore" Text="—" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TxtPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="k-NN (k=3)" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/>
                                <TextBlock x:Name="KnnScore" Text="—" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TxtPrimary}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="EnsembleExplanation" Margin="0,12,0,0" FontSize="12" 
                                   Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Health Alerts -->
                <Border x:Name="AlertPanel" Style="{StaticResource StatCardStyle}" 
                        Background="#EF444420" BorderBrush="#EF4444" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠️ Physiological alerts" FontWeight="SemiBold" 
                                   Foreground="#EF4444" Margin="0,0,0,8"/>
                        <TextBlock x:Name="AlertMessage" FontSize="12" Foreground="{DynamicResource TxtPrimary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
