<Window x:Class="focus_ai.TrendAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Focus AI · Trend analysis" Height="860" Width="1320"
        MinHeight="760" MinWidth="1080" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="Background" Value="{DynamicResource AccentPrimary}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button"><Setter Property="Background" Value="{DynamicResource BgCard}"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="{DynamicResource BgSep}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource BgCardHover}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="StatCardStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource BgCard}"/><Setter Property="BorderBrush" Value="{DynamicResource BgSep}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="20"/></Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource TxtMuted}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgRoot}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BgSep}" BorderThickness="0,0,0,1" Padding="34,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FOCUS AI  /  PATIENT INSIGHTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/><TextBlock Text="Cognitive trajectory" FontSize="30" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,8,0,0"/><TextBlock x:Name="TitlePatient" Text="Patient: loading..." FontSize="13" Foreground="{DynamicResource TxtSecondary}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="↻  Refresh analysis" Style="{StaticResource PrimaryButtonStyle}" Click="Refresh_Click" VerticalAlignment="Center"/></Grid></Border>
        <Grid Grid.Row="1" Margin="34,28,34,26"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SCORE EVOLUTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/><TextBlock Text="Observed performance and next-session estimate" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,8,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Top"><TextBlock Text="MODEL OUTPUT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border></Grid><oxy:PlotView x:Name="TrendPlot" Grid.Row="1" MinHeight="360" Height="440" Margin="0,18,0,16"/><Border Grid.Row="2" Background="{DynamicResource BgSection}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="INTERPRETATION" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><TextBlock x:Name="PredictionAnnotation" FontSize="13" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/></StackPanel></Border></Grid></Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="PREDICTION SUMMARY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,12"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Predicted score" FontSize="13" Foreground="{DynamicResource TxtSecondary}"/><TextBlock x:Name="PredictedScoreValue" Text="—" FontSize="30" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,4,0,0"/><TextBlock x:Name="PredictionRange" FontSize="11" Foreground="{DynamicResource TxtSecondary}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="↗" FontSize="24" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Top"/></Grid><Rectangle Height="1" Fill="{DynamicResource BgSep}" Margin="0,4,0,14"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Direction of change" FontSize="13" Foreground="{DynamicResource TxtSecondary}"/><TextBlock x:Name="TrendLabel" Text="—" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,4,0,0"/><TextBlock x:Name="TrendPerSession" FontSize="11" Foreground="{DynamicResource TxtSecondary}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Width="38" Height="38"><TextBlock Text="↗" FontSize="18" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><Rectangle Height="1" Fill="{DynamicResource BgSep}" Margin="0,0,0,14"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prediction interval" FontSize="13" Foreground="{DynamicResource TxtSecondary}"/><TextBlock x:Name="IntervalStatusLabel" Text="—" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Margin="0,4,0,0"/><TextBlock x:Name="MAEValue" FontSize="11" Foreground="{DynamicResource TxtSecondary}" Margin="0,3,0,0"/></StackPanel></Grid><Rectangle Height="1" Fill="{DynamicResource BgSep}" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sessions analyzed" FontSize="13" Foreground="{DynamicResource TxtSecondary}" VerticalAlignment="Center"/><TextBlock x:Name="SessionsCount" Text="—" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" Grid.Column="1"/></Grid></StackPanel></Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="MODEL COMPARISON" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,14"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Linear regression" FontSize="12" Foreground="{DynamicResource TxtSecondary}"/><TextBlock x:Name="LinearRegrScore" Text="—" Grid.Column="1" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/></Grid><Rectangle Height="1" Fill="{DynamicResource BgSep}" Margin="0,0,0,12"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Holt smoothing" FontSize="12" Foreground="{DynamicResource TxtSecondary}"/><TextBlock x:Name="HoltScore" Text="—" Grid.Column="1" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/></Grid><Rectangle Height="1" Fill="{DynamicResource BgSep}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="k-NN (k=3)" FontSize="12" Foreground="{DynamicResource TxtSecondary}"/><TextBlock x:Name="KnnScore" Text="—" Grid.Column="1" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/></Grid><TextBlock x:Name="EnsembleExplanation" Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="19"/></StackPanel></Border>
                <Border x:Name="AlertPanel" Background="#2E171C" BorderBrush="#75323B" BorderThickness="1" CornerRadius="22" Padding="20" Visibility="Collapsed"><StackPanel><TextBlock Text="PHYSIOLOGICAL ALERTS" FontSize="10" FontWeight="SemiBold" Foreground="#FCA5A5" Margin="0,0,0,8"/><TextBlock x:Name="AlertMessage" FontSize="12" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="19"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BgSep}" BorderThickness="0,1,0,0" Padding="24,14"><Grid><TextBlock Text="PREDICTIVE ANALYTICS  /  FOCUS AI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="Close analysis" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/></Grid></Border>
    </Grid>
</Window>
