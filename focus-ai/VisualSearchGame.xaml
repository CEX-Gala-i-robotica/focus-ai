<Window x:Class="focus_ai.VisualSearchGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI - Visual Search"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        Closing="Window_Closing">
    <Grid x:Name="RootGrid" Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack"
                            Content="← Back"
                            FontSize="13" FontWeight="SemiBold"
                            Background="{DynamicResource AccentSecBg}"
                            Foreground="{DynamicResource AccentSecFg}"
                            BorderThickness="0" Cursor="Hand"
                            Padding="14,8"
                            Click="BtnBack_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="18" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccentSecHov}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="03" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Visual Search" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TxtPrimary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgStatBlue}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ROUND" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtStatBlue}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtRound" Text="0/8" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgStatGreen}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="SCORE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtStatGreen}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtScore" Text="0" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgStatOrange}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="LIVES" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtStatOrange}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLives" Text="3 / 3" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource TxtPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgStatPurple}" CornerRadius="10" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="TIME" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TxtStatPurple}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTimer" Text="20" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BgMain}" Padding="20,16">
            <Grid>
                <Border x:Name="PanelInstruction" Background="{DynamicResource BgRoot}" CornerRadius="24" Padding="46,38" BorderBrush="{DynamicResource BgSep}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="SELECTIVE ATTENTION  /  03" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,18" TextAlignment="Left"/>
                            <TextBlock Text="Find the signal in the noise." FontSize="42" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="48" TextAlignment="Left"/>
                            <TextBlock Text="Scan a field of similar symbols and locate the one item that breaks the pattern. The visual field expands as you progress." FontSize="15" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,26" MaxWidth="490" HorizontalAlignment="Left" TextAlignment="Left"/>
                            <Grid Margin="0,0,0,10" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="13" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Eight rounds with increasing difficulty" FontSize="13" Foreground="{DynamicResource TxtPrimary}" TextAlignment="Left"/></Grid>
                            <Grid Margin="0,0,0,24" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="13" Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Three lives — choose carefully, not randomly" FontSize="13" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" TextAlignment="Left"/></Grid>
                            <TextBlock Text="DIFFICULTY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><RadioButton x:Name="RbEasy" Content="Easy · 25s" GroupName="Diff" Foreground="{DynamicResource TxtPrimary}" Margin="0,0,20,0"/><RadioButton x:Name="RbMedium" Content="Medium · 20s" GroupName="Diff" IsChecked="True" Foreground="{DynamicResource TxtPrimary}" Margin="0,0,20,0"/><RadioButton x:Name="RbHard" Content="Hard · 15s" GroupName="Diff" Foreground="{DynamicResource TxtPrimary}"/></StackPanel>
                            <Button x:Name="BtnStart" Content="Start visual search  →" Background="{DynamicResource AccentPrimary}" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Padding="22,13" HorizontalAlignment="Left" Click="BtnStart_Click"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="28" Padding="24" VerticalAlignment="Center">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="VISUAL FIELD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/><TextBlock Grid.Column="1" Text="PREVIEW / 01" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/></Grid>
                                <Border Background="{DynamicResource BgSection}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="22" Padding="18" Margin="0,18,0,18"><TextBlock Text="S  S  S  S  S  S  S  S&#x0a;S  S  5  S  S  S  S  S&#x0a;S  S  S  S  S  S  S  S&#x0a;S  S  S  S  S  S  S  S" FontSize="19" FontWeight="Medium" FontFamily="Consolas, Courier New" Foreground="{DynamicResource TxtPrimary}" LineHeight="35" TextAlignment="Center" HorizontalAlignment="Center"/></Border>
                                <TextBlock Text="TARGET RECOGNITION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/>
                                <TextBlock Text="Stay systematic. The target could appear in any position." FontSize="13" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="PanelGame" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid x:Name="GameGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,8"/>
                    </ScrollViewer>

                    <Border x:Name="PanelFeedback" Visibility="Collapsed"
                            Background="#CC000000" CornerRadius="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="32,24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFeedbackIcon" Text="✅" FontSize="48"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtFeedbackMsg" Text="" FontSize="20" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtFeedbackSub" Text="" FontSize="13"
                                       Foreground="#DDDDDD" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="4" Height="6" VerticalAlignment="Center">
                    <Border x:Name="TimerBar" CornerRadius="4" Background="{DynamicResource AccentPrimary}"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="TxtRoundInfo" Text="Round 1/8" FontSize="11"
                           Foreground="{DynamicResource TxtMuted}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" x:Name="WinOverlay" Visibility="Collapsed"
                Background="#CC000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgCard}" CornerRadius="24"
                    Padding="32,28" MinWidth="360" MaxWidth="420">
                <StackPanel>
                    <TextBlock x:Name="WinEmoji" Text="SESSION COMPLETE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSecFg}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="WinTitle" Text="Congratulations!" FontSize="26"
                               FontWeight="Bold" Foreground="{DynamicResource TxtPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="WinSubtitle" Text=""
                               FontSize="14" Foreground="{DynamicResource TxtSecondary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,24"/>
                    <TextBlock x:Name="WinScore" Text="Score: 0"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>
                    <Button Content="🔄  Play again"
                            Click="BtnRestart_Click"
                            Background="{DynamicResource AccentPrimary}"
                            Foreground="White" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            Padding="20,10" HorizontalAlignment="Center"
                            Margin="0,0,0,12" MinWidth="180">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccentHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="← Back to menu"
                            Click="BtnHome_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentPrimary}"
                            FontSize="13" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            Padding="20,10" HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource BgNavHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>