<Window x:Class="focus_ai.GoNoGoTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:focus_ai"
        mc:Ignorable="d"
        Title="Focus AI – GO/NO-GO"
        Height="800" Width="1200"
        WindowState="Maximized"
        ResizeMode="CanMinimize">

    <Window.Resources>

        
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="2.2" Duration="0:0:1.0"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="2.2" Duration="0:0:1.0"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:1.0"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="2.2" Duration="0:0:1.0" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="2.2" Duration="0:0:1.0" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:1.0" BeginTime="0:0:0.4"/>
        </Storyboard>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   
            <RowDefinition Height="*"/>      
            <RowDefinition Height="Auto"/>   
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}"
                Padding="40,22,40,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="INHIBITORY CONTROL  /  PROTOCOL 06" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,5"/>
                    <TextBlock Text="Go / No-Go" FontSize="25" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/>
                    <TextBlock x:Name="InstructionText" Text="Respond only to green GO stimuli. Withhold your response when red NO-GO stimuli appear." FontSize="13" Foreground="{DynamicResource TxtSecondary}" Margin="0,5,0,0"/>
                </StackPanel>

                
                <Border Grid.Column="1" Background="{DynamicResource BgCard}"
                        CornerRadius="14" Padding="24,12" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TIME LEFT" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TxtMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock x:Name="CountdownText"
                                   Text="30"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentSecFg}"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TimerStatusText"
                                   Text="Waiting"
                                   FontSize="10" Foreground="{DynamicResource TxtMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        
        <Grid Grid.Row="1">

            
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                
                <Ellipse x:Name="PulseRing1"
                         Width="260" Height="260"
                         Opacity="0" IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <ScaleTransform CenterX="130" CenterY="130"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="PulseRing1Brush" Color="#2222C55E"/>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse x:Name="PulseRing2"
                         Width="260" Height="260"
                         Opacity="0" IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <ScaleTransform CenterX="130" CenterY="130"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="PulseRing2Brush" Color="#2222C55E"/>
                    </Ellipse.Fill>
                </Ellipse>

                
                <Ellipse x:Name="StimulusCircle"
                         Width="260" Height="260">
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="CircleBrush" Color="#1F2937"/>
                    </Ellipse.Fill>
                </Ellipse>

                
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StimulusLabel"
                               Text="—"
                               FontSize="52" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock x:Name="StimulusSubLabel"
                               Text=""
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="#99FFFFFF"
                               Margin="0,4,0,0"/>
                </StackPanel>

            </Grid>

            
                        <Border x:Name="OverlayPanel" Background="{DynamicResource BgRoot}" Visibility="Visible">
                <Grid Margin="64,42,64,44"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="RESPONSE INHIBITION  /  06" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}" Margin="0,0,0,18"/>
                        <TextBlock x:Name="OverlayTitle" Text="Ready for the GO/NO-GO test?" FontSize="42" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" LineHeight="48"/>
                        <TextBlock x:Name="OverlayBody" Text="The test lasts 30 seconds. Press the sensor ONLY when GREEN appears (GO). Ignore RED (NO-GO). False reactions are penalized." FontSize="15" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,18,0,0" MaxWidth="560"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="30" Padding="30" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="SIGNAL GUIDE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtMuted}"/>
                            <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="#22C55E" BorderBrush="#4ADE80" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="GO" FontSize="10" FontWeight="Bold" Foreground="#052E16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Respond" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Green means you should trigger a response." FontSize="12" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                            <Border Height="1" Background="{DynamicResource BgSep}" Margin="0,18,0,18"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="#EF4444" BorderBrush="#F87171" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="NO" FontSize="10" FontWeight="Bold" Foreground="#450A0A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Withhold" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Red means do not respond; false positives are penalized." FontSize="12" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                            <Button x:Name="BeginButton" Content="Begin test  →" HorizontalAlignment="Stretch" Margin="0,26,0,0" Padding="22,13" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource AccentPrimary}" BorderThickness="0" Cursor="Hand" Click="BeginButton_Click"/>
                            <TextBlock Text="30-second protocol · sensor response" FontSize="11" Foreground="{DynamicResource TxtMuted}" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        
        <Border Grid.Row="2" Background="{DynamicResource BgSidebar}"
                Padding="40,14,40,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="CORRECT GO" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CorrectGoText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>

                
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="FALSE POSITIVES" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FalsePosText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#EF4444" HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>

                
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="AVERAGE RESPONSE TIME" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AvgRtText" Text="-- ms"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TxtPrimary}" HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>
