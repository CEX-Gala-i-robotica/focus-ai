<Window x:Class="focus_ai.GameSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus AI · Cognitive activities" Height="800" Width="1180"
        MinHeight="700" MinWidth="1040" WindowState="Maximized" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="GameCardStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgSep}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,16"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BgCardHover}"/><Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/><Setter TargetName="CardBorder" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CardBorder" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="KickerText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TxtMuted}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{DynamicResource BgRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BgSep}" BorderThickness="0,0,0,1" Padding="40,28">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="11,5"><TextBlock Text="FOCUS AI  /  TRAINING LIBRARY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/></Border></StackPanel><TextBlock Text="Cognitive activities" FontSize="32" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Short, intentional exercises for memory, attention and response control." FontSize="14" Foreground="{DynamicResource TxtSecondary}" Margin="0,8,0,0"/></StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="14,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Border Width="8" Height="8" Background="{DynamicResource AccentPrimary}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock Text="5 TRAINING MODULES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}" VerticalAlignment="Center"/></StackPanel></Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="40,30,40,36"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><Grid Margin="14,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="NO." Style="{StaticResource KickerText}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="EXERCISE" Style="{StaticResource KickerText}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="FOCUS AREA" Style="{StaticResource KickerText}" VerticalAlignment="Center"/></Grid>
                <Button Style="{StaticResource GameCardStyle}" Click="GameMemorie_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="01" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Memory" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Match pairs and hold visual information in mind." FontSize="12" Foreground="{DynamicResource TxtSecondary}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="WORKING MEMORY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border><TextBlock Grid.Column="3" Text="↗" FontSize="19" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                <Button Style="{StaticResource GameCardStyle}" Click="GameStroop_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="02" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Stroop test" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Identify the ink color and resist word interference." FontSize="12" Foreground="{DynamicResource TxtSecondary}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="INHIBITION" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border><TextBlock Grid.Column="3" Text="↗" FontSize="19" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                <Button Style="{StaticResource GameCardStyle}" Click="GameVisualSearch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="03" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Visual search" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Locate a target among similar visual distractors." FontSize="12" Foreground="{DynamicResource TxtSecondary}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="SELECTIVE ATTENTION" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border><TextBlock Grid.Column="3" Text="↗" FontSize="19" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                <Button Style="{StaticResource GameCardStyle}" Click="GameSecvente_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="04" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Sequences" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Remember and repeat a growing sequence of cues." FontSize="12" Foreground="{DynamicResource TxtSecondary}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="SEQUENTIAL MEMORY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border><TextBlock Grid.Column="3" Text="↗" FontSize="19" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
                <Button Style="{StaticResource GameCardStyle}" Click="GameMatematica_Click" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="05" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Quick math" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}"/><TextBlock Text="Solve timed operations with accuracy and speed." FontSize="12" Foreground="{DynamicResource TxtSecondary}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource BgNavActive}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="PROCESSING SPEED" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TxtSecondary}"/></Border><TextBlock Grid.Column="3" Text="↗" FontSize="19" Foreground="{DynamicResource TxtMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button>
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="28" Padding="28" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="THE TRAINING APPROACH" Style="{StaticResource KickerText}"/><TextBlock Text="Progress through practice, not noise." FontSize="27" FontWeight="Medium" Foreground="{DynamicResource TxtPrimary}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="33"/><TextBlock Text="Each activity focuses on a different cognitive skill. Keep sessions intentional, then review the results alongside the assessment history." FontSize="14" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/></StackPanel><Grid Grid.Row="1" Margin="0,26,0,26"><Canvas Height="190" ClipToBounds="True"><Line X1="0" Y1="28" X2="320" Y2="28" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Line X1="0" Y1="72" X2="320" Y2="72" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Line X1="0" Y1="116" X2="320" Y2="116" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Line X1="0" Y1="160" X2="320" Y2="160" Stroke="{DynamicResource BgSep}" StrokeThickness="1"/><Path Data="M 0,135 C 28,126 36,76 64,88 S 105,152 133,102 S 174,38 201,65 S 242,134 270,65 S 303,42 320,24" Stroke="#80ACFF" StrokeThickness="2" Fill="Transparent"/><Path Data="M 0,156 C 28,154 47,131 73,142 S 119,122 145,132 S 194,160 220,131 S 275,147 320,104" Stroke="#4C6DAB" StrokeThickness="1.4" Opacity="0.75" Fill="Transparent"/></Canvas></Grid><Border Grid.Row="2" Background="{DynamicResource BgSection}" BorderBrush="{DynamicResource BgSep}" BorderThickness="1" CornerRadius="18" Padding="18"><StackPanel><TextBlock Text="A CONSISTENT ROUTINE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecFg}"/><TextBlock Text="Choose one exercise, stay focused, and return to the results to follow performance over time." FontSize="13" Foreground="{DynamicResource TxtSecondary}" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20"/></StackPanel></Border></Grid></Border>
        </Grid>
    </Grid>
</Window>
